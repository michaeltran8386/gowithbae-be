# Copy thành .env (đã gitignore) rồi điền giá trị thật. Không commit .env.
# Supabase → Project Settings → Database → Connection string → JDBC.
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# Tối thiểu 32 byte ngẫu nhiên, ví dụ: openssl rand -base64 48
JWT_SECRET=<random-32+-bytes>

# SMTP thật hoặc SMTP thử nghiệm riêng. Không bật mail debug vì nội dung có OTP.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=<sender-email>
SMTP_AUTH=true
SMTP_STARTTLS=true

# Khóa mã hóa TOTP, ít nhất 32 byte; nên tách khỏi JWT_SECRET và sao lưu an toàn.
# Nếu chưa đặt, dev dùng khóa dẫn xuất từ JWT_SECRET (đổi JWT_SECRET sẽ cần enroll lại MFA).
AUTH_MFA_KEY=<separate-random-32+-bytes>

# Tùy chọn: URL gốc của nơi lưu ảnh (ghép với stored_file.storage_key). Để trống = ảnh trả null.
FILES_PUBLIC_BASE_URL=
