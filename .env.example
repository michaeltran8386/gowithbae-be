# Copy thành .env (đã gitignore) rồi điền giá trị thật. Không commit .env.
# Supabase → Project Settings → Database → Connection string → JDBC.
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# Tối thiểu 32 byte ngẫu nhiên, ví dụ: openssl rand -base64 48
JWT_SECRET=<random-32+-bytes>

# SMTP thật hoặc SMTP thử nghiệm riêng. Không bật mail debug vì nội dung có OTP.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=<sender-email>
SMTP_AUTH=true
SMTP_STARTTLS=true

# Khóa mã hóa TOTP, ít nhất 32 byte; nên tách khỏi JWT_SECRET và sao lưu an toàn.
# Nếu chưa đặt, dev dùng khóa dẫn xuất từ JWT_SECRET (đổi JWT_SECRET sẽ cần enroll lại MFA).
AUTH_MFA_KEY=<separate-random-32+-bytes>

# Tùy chọn: URL gốc ghép với id tệp cho ảnh địa điểm/bộ sưu tập.
# Để trống = /api/v1/files/ (backend phục vụ ảnh đã gắn vào địa điểm/bộ sưu tập). Đặt khi dùng CDN (OQ-21).
FILES_PUBLIC_BASE_URL=

# URL gốc của web (không kèm đường dẫn) cho link kích hoạt TOTP của admin: <APP_WEB_BASE_URL>/admin/activate/<token>.
APP_WEB_BASE_URL=http://localhost:5173

# Tiền tố đầy đủ của link mời cùng chọn (kèm /invite). Để trống = suy ra từ request.
APP_INVITE_BASE_URL=http://localhost:5173/invite

# Nơi lưu ảnh/tệp: local (mặc định, thư mục .local-data/uploads) hoặc supabase.
# Deploy lên Render (không có ổ đĩa lâu dài) thì đặt supabase, nếu không ảnh mất mỗi lần khởi động lại.
FILES_STORAGE=local
# Khi FILES_STORAGE=supabase: URL project (https://<ref>.supabase.co), secret key (Project Settings → API Keys),
# bucket riêng tư đã tạo sẵn.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=gowithbae-files
